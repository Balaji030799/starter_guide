function reverseArray(arr) {
  // Your code
  let Revered = [];
  for (let i = arr.length - 1; i >= 0; i--) {
    Revered.push(arr[i]);
  }
  return Revered;
}
var reverseString = function (s) {
  let copy = [...s];
  for (let i = 0; i < copy.length; i++) {
    s[copy.length - 1 - i] = copy[i];
  }
};
//two pointers
var reverseString = function (s) {
  let left = 0;
  let right = s.length - 1;

  while (left < right) {
    let temp = s[left];
    s[left] = s[right];
    s[right] = temp;

    left++;
    right--;
  }
};

function twoSum(target, array) {
  for (let index = 0; index < array.length; index++) {
    const a = array[index];
    for (let j = index + 1; j < array.length; j++) {
      const b = array[j];
      if (target === a + b) {
        return [index, j];
      }
    }
  }

  return -1;
}

function twoSumMap(target, array) {
  let map = new Map();
  for (let index = 0; index < array.length; index++) {
    const complement = target - array[index];
    if (map.has(complement)) {
      return [map.get(complement), index];
    }
    map.set(array[index], index);
  }
  return -1;
}


function findMax(arr) {
  let max = arr[0]; 
  for(let i=1;i<arr.length;i++){
   if(arr[i]>max){
    max= arr[i];
   }
  }
  return max;
}

function findSum(arr){
    let sum = 0; 
  for(let i=0;i<arr.length;i++){
    sum += BigInt(arr[i]);
   }
  
  return sum;
}

function findCountEven(arr){
  let count=0;
  for(let i =0; i<arr.length;i++){
    if(arr[i]%2===0){
      count +=1;
    }
  }
  return count;
}

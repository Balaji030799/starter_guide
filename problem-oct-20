var isAnagram = function (s, t) {
  if (s.length !== t.length) return false;

  let s1 = {};
  let s2 = {};

  for (let i = 0; i < s.length; i++) {
    if (s1[s[i]]) {
      s1[s[i]]++;
    } else {
      s1[s[i]] = 1;
    }

    if (s2[t[i]]) {
      s2[t[i]]++;
    } else {
      s2[t[i]] = 1;
    }
  }

  for (let key in s1) {
    if (s1[key] !== s2[key]) {
      return false;
    }
  }

  return true;
};
console.log(isAnagram("anagram", "nagaram"));
console.log(isAnagram("rat", "car"));

var isAnagram = function (s, t) {
  if (s.length !== t.length) return false;
  return s.split("").sort().join("") === t.split("").sort().join("");
};

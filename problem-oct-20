function firstRepeated(arr) {
  let uniqueSet = new Set();
  for (let i = 0; i < arr.length; i++) {
    if (uniqueSet.has(arr[i])) {
      return arr[i];
    }

    uniqueSet.add(arr[i]);
  }
  return -1;
}
console.log(firstRepeated([1, 2, 3]));

function matchingStrings(stringList, queries) {
  // Write your code here
  let matchStr = new Array(queries.length).fill(0);
  for (let i = 0; i < stringList.length; i++) {
    let query = stringList[i];
    for (let j = 0; j < queries.length; j++) {
      if (query === queries[j]) {
        if (matchStr[j]) {
          matchStr[j]++;
        } else {
          matchStr[j] = 1;
        }
      }
    }
  }

  return matchStr;
}
